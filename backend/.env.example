# Ejemplo de variables de entorno para backend
# Rellena con tus valores reales y guarda como .env

# URL de conexión a la base de datos PostgreSQL
# Formato: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:tu_contraseña@localhost:5432/airline_reservation_system

# Si usas SSL para la BD
DB_SSL=false

# Puerto del servidor
PORT=3000

# Clave para firmar JWT (cámbiala en producción)
JWT_SECRET=tu_jwt_secret_aqui

# Origen permitido del frontend (opcional)
FRONTEND_ORIGIN=http://localhost:5500